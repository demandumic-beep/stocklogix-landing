# Скопіюйте як ".env"
# SQLite-файл створиться сам (для продакшну див. README: перехід на Postgres)
DATABASE_URL=file:./landing.db

# Будь-який довгий випадковий рядок
PAYLOAD_SECRET=змініть_мене_на_довгий_випадковий_рядок

# Звідки frontend звертається до CMS (дозволений CORS)
FRONTEND_URL=http://localhost:5173

# Публічна адреса самої CMS (потрібна, щоб картинки мали повні посилання)
CMS_URL=http://localhost:3000
